/*----------------------------------------------------------------------------*/
/* Settings window */

SettingsDialog QPushButton {
    min-height: %button_height%;
}

SettingsDialog QComboBox {
    /*min-height: 20px;*/
}

[accessibleName="SLine"] {
    background-color: %sys_window_tinted%;
    min-height: 1px;
    max-height: 1px;
}

[accessibleName="SHeaderLine"] {
    background-color: %sys_window_tinted_hc%;
    min-height: 1px;
    max-height: 1px;
}

[accessibleName="SHeaderText"] {
    font-size: %font_large%;
}

[accessibleName="SSideBarContainer"] {
    background-color: %sys_window_tinted_lc2%;
    border-right: 1px solid %sys_window_tinted_lc%;
}

SSideBarItem {
    border-radius: 5px;
}

SSideBarItem[checked="true"] {
    background-color: %sys_window_tinted_hc%;
}

[accessibleName="SGroup"] {
    /*border: 1px solid %sys_window_tinted_hc%;*/
    border: 1px solid %sys_window_tinted_lc%;
    border-radius: 6px;
    background-color: %sys_window_tinted_lc2%;
}

[accessibleName="SGroup"]:hover {
    /*border-color: %sys_window_tinted_hc%;*/
    /*background-color: %sys_window_tinted_lc%;*/
}

[accessibleName="SNoteText"] {
    color: %sys_text_secondary_rgba%;
}

/*----------------------------------------------------------------------------*/
/* Buttons */

[accessibleName="Button"], [accessibleName="ButtonSetLeft"], [accessibleName="ButtonSetRight"]
{
    color: %text_hc%;
    background-color: %button%;
    border-radius: 3px;
    padding: 7px 12px 7px 12px;
}

[accessibleName="Button"]:hover, [accessibleName="ButtonSetLeft"]:hover, [accessibleName="ButtonSetRight"]:hover
{
    background-color: %button_hover%;
    color: %text_hc2%;
}

/* TODO: fix me */
[accessibleName="Button"]:pressed,
[accessibleName="Button"][pressed="true"],
[accessibleName="ButtonSetLeft"]:pressed,  [accessibleName="ButtonSetLeft"][pressed="true"],
[accessibleName="ButtonSetRight"]:pressed, [accessibleName="ButtonSetRight"][pressed="true"]
{
    background-color: %button_pressed%;
    color: %text%;
}

[accessibleName="ButtonSetLeft"] {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

[accessibleName="ButtonSetRight"] {
    border-left: 1px solid %button_pressed%;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

[accessibleName="ButtonSetRight"]:hover {
    border-left: 1px solid %button_pressed%;
}

/*----------------------------------------------------------------------------*/
[accessibleName="CheckableButton"] {
    border-radius: 3px;
    margin-top:    4px;
    margin-bottom: 4px;
    margin-left:   2px;
    margin-right:  2px;
}

/* extra 2px left margin for fitt's law */
[accessibleName="CheckableButtonLE"] {
    border-radius: 3px;
    margin-top:    4px;
    margin-bottom: 4px;
    margin-left:   4px;
    margin-right:  2px;
}

[accessibleName="CheckableButton"]:hover,
[accessibleName="CheckableButtonLE"]:hover {
    background-color: %panel_button_hover%;
    border: 1px solid %panel_button_hover%;
}

[accessibleName="CheckableButton"]:pressed,
[accessibleName="CheckableButtonLE"]:pressed,
[accessibleName="CheckableButton"][pressed="true"],
[accessibleName="CheckableButtonLE"][pressed="true"],
[accessibleName="CheckableButton"][checked="true"],
[accessibleName="CheckableButtonLE"][checked="true"] {
    background-color: %panel_button%;
    border: 1px solid %panel_button%;
}

/*----------------------------------------------------------------------------*/
[accessibleName="PanelButton"] {
    border-radius: 3px;
    margin-top:    4px;
    margin-bottom: 4px;
    margin-left:   2px;
    margin-right:  2px;
}

[accessibleName="PanelButtonRE"] {
    border-radius: 3px;
    margin-top:    4px;
    margin-bottom: 4px;
    margin-left:   2px;
    margin-right:  4px;
}

[accessibleName="PanelButton"]:hover,
[accessibleName="PanelButtonRE"]:hover {
    background-color: %panel_button_hover%;
    border: 1px solid %panel_button_hover%;
}

[accessibleName="PanelButton"]:pressed,
[accessibleName="PanelButtonRE"]:pressed,
[accessibleName="PanelButton"][pressed="true"],
[accessibleName="PanelButtonRE"][pressed="true"] {
    background-color: %panel_button%;
    border: 1px solid %panel_button%;
}
/*----------------------------------------------------------------------------*/

[accessibleName="ButtonSmall"] {
    border-radius: 1px;
    border: 1px solid transparent;
}

[accessibleName="ButtonSmall"]:hover {
    background-color: %folderview_hc2%;
    border: 1px solid %folderview_hc2%;
}

[accessibleName="ButtonSmall"][checked="true"] {
    background-color: %folderview_hc%;
    border: 1px solid %folderview_hc%;
}

/*----------------------------------------------------------------------------*/
/* remove ugly dotted border  */
QComboBox QAbstractItemView {
    outline: 0px;
}

[accessibleName="PanelComboBox"] {
    background-color: %panel_button%;
    color: %text_hc%;
    border: 2px solid %panel_button%;
    border-radius: 3px;
    padding: 2px 8px 2px 5px;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left:  2px;
    margin-right: 2px;
}

[accessibleName="PanelComboBox"]:hover {
    background-color: %panel_button_hover%;
    border-color: %panel_button_hover%;
}

[accessibleName="PanelComboBox"]::drop-down {
    border: 0px;
}

[accessibleName="PanelComboBox"] QAbstractItemView {
    padding: 5px 5px 5px 5px;
    background-color: %widget%;
    border: 1px solid %accent%;
}

[accessibleName="PanelComboBox"] QAbstractItemView::item {
    border-radius: 1px;
    padding: 4px 5px;
    color: %text_hc%;
    min-height: 22px;
}

[accessibleName="PanelComboBox"] QAbstractItemView::item:selected {
    background-color: %accent_hover_rgba%;
}

/*----------------------------------------------------------------------------*/
/* panel buttons holder widget */

[accessibleName="panelButtonsWidget"] {
    background-color: %folderview%;
}

/*----------------------------------------------------------------------------*/
/* Overlays */
/*----------------------------------------------------------------------------*/

FloatingWidget {
    background-color: %widget%;
    border: 1px solid %widget_border%;
    border-radius: 3px;
}
/*----------------------------------------------------------------------------*/
[accessibleName="OverlayHeaderWidget"] {
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
}
/*----------------------------------------------------------------------------*/
[accessibleName="OverlayHeaderButton"],
[accessibleName="OverlayHeaderIcon"] {
    min-height: %overlay_header_size%;
    min-width: %overlay_header_size%;
}

[accessibleName="OverlayHeaderButton"] {
    background-color: transparent;
    margin: 3px;
    border-radius: 3px;
}

[accessibleName="OverlayHeaderButton"]:hover {
    background-color: %button_hover%;
}

[accessibleName="OverlayHeaderButton"][pressed="true"] {
    background-color: %button_pressed%;
    color: %text%;
}

[accessibleName="OverlayHeaderLabel"] {
    color: %text_hc%;
}

FloatingWidget QLineEdit {
    background-color: %button%;
    color: %text_hc%;
    border: 2px solid %button%;
    border-radius: 3px;
    padding: 4px 6px 4px 6px;
    margin-top: 5px;
    margin-bottom: 5px;
}

FloatingWidget QLineEdit::hover,
FloatingWidget QLineEdit::focus {
    background-color: %button_hover%;
    border-color: %button_hover%;
}

RenameOverlay {
    background-color: %fv_backdrop_rgba%;
}

[accessibleName = "RenameOverlayWidget"] {
    background-color: %widget%;
    border: 1px solid %widget_border%;
    border-radius: 3px;
    min-width: %rename_overlay_width%;
}

/*----------------------------------------------------------------------------*/

FullscreenInfoOverlay {
    border: 0px solid transparent;
    background-color: %overlay_rgba%;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 3px;
}

FullscreenInfoOverlay QLabel {
    color: %overlay_text%;
}

/*----------------------------------------------------------------------------*/
/* Notifications */
/*----------------------------------------------------------------------------*/

FloatingMessage QLabel {
    color: %text_hc%;
    font: bold;
}

/*----------------------------------------------------------------------------*/
/* Crop panel */
/*----------------------------------------------------------------------------*/

SidePanel {
    background-color: %widget%;
    border-left: 1px solid %widget_border%;
}
/*----------------------------------------------------------------------------*/
SidePanel QGroupBox {
    background-color: %widget%;
    border: 1px solid %button%;
    border-radius: 3px;
    padding: 6px 10px 8px 10px;
}
/*----------------------------------------------------------------------------*/
SidePanel QSpinBox,
SidePanel QDoubleSpinBox
{
    color: %text%;
    background-color: %button%;
    border: 2px solid %button%;
    border-radius: 3px;
    padding: 2 0 2 0;
    min-height: 20px;
}

SidePanel QSpinBox:hover,
SidePanel QDoubleSpinBox:hover
{
    background-color: %button_hover%;
    border-color: %button_hover%;
}

SidePanel QSpinBox:focus,
SidePanel QDoubleSpinBox:focus
{
    background-color: %button_hover%;
    border-color: %button_hover%;
}

SidePanel QSpinBox::up-button,
SidePanel QDoubleSpinBox::up-button
{
    max-width: 0px;
    max-height: 0px;
    width:0px;
}

SidePanel QSpinBox::down-button,
SidePanel QDoubleSpinBox::down-button
{
    max-width: 0px;
    max-height: 0px;
    width:0px;
}
/*----------------------------------------------------------------------------*/
SidePanel QLabel {
    color: %text_hc%;
}
/*----------------------------------------------------------------------------*/
SidePanel QComboBox {
    color: %text%;
    background-color: %button%;
    border: 1px solid %button%;
    border-radius: 3px;
    padding: 4px 8px 4px 8px;
}

SidePanel QComboBox:hover {
    background-color: %button_hover%;
    border-color: %button_hover%;
}

SidePanel QComboBox::drop-down {
    border: 0px;
}

/* dropdown menus */
SidePanel QComboBox QAbstractItemView {
    padding: 5px 0px;
    background-color: %widget%;
    border: 1px solid %accent%;
}

SidePanel QComboBox QAbstractItemView::item {
    border-radius: 1px;
    padding: 2px 5px;
    color: %text_hc%;
    min-height: 22px;
}

SidePanel QComboBox QAbstractItemView::item:selected {
    background-color: %accent_hover_rgba%;
}

[accessibleName="HLineSeparator"] {
    border-bottom: 1px solid %button%;
}

/*----------------------------------------------------------------------------*/
/* changelog window */
/*----------------------------------------------------------------------------*/

ChangelogWindow QTextBrowser {
    background-color: %widget%;
    color: %text%;
}

/*----------------------------------------------------------------------------*/
/* Video controls */
/*----------------------------------------------------------------------------*/

VideoControls QLabel {
    color: %text_hc2%;
    font: bold;
}
/*----------------------------------------------------------------------------*/
VideoControls QSlider {
    border: 2px solid %widget%;
    margin: 1px;
}

VideoControls QSlider::groove:horizontal,
VideoControls QSlider::add-page:horizontal {
    background: %button_pressed%;
    border-radius: 3px;
}

VideoControls QSlider::handle:horizontal {
    height: 0px;
    width:  0px;
    background: %text_hc%;
}

VideoControls QSlider::sub-page:horizontal {
    background: %text_hc%;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

/*----------------------------------------------------------------------------*/
/* File copy - move window */
/*----------------------------------------------------------------------------*/

PathSelectorMenuItem [accessibleName="MenuItemIcon"] {
    padding: 5px;
}

PathSelectorMenuItem [accessibleName="MenuItemIcon"]:hover {
    background-color: %accent_hover_rgba%;
}


/*----------------------------------------------------------------------------*/
/* Video background. Pretty sure this doesn't work.. */
/*----------------------------------------------------------------------------*/

[accessibleName="mpvContainer"] {
    background-color: black;
}

/*----------------------------------------------------------------------------*/
/* Thumbnails views and scrollbars */
/*----------------------------------------------------------------------------*/

ThumbnailView {
    border-style: none;
}
/*----------------------------------------------------------------------------*/
ThumbnailStrip {
    background-color: %folderview%;
}
/*----------------------------------------------------------------------------*/
PanelButtonsHolder {
    background-color: red;
    border: 1px solid blue;
}
/*----------------------------------------------------------------------------*/
FolderGridView {
    background-color: %folderview%;
}
/*----------------------------------------------------------------------------*/
FolderView {
    background-color: %folderview%;
}
[accessibleName="FolderViewContents"] {
    border-top: 1px solid %topbar_border_rgba%;
}
/*----------------------------------------------------------------------------*/
[accessibleName="FolderViewTopBar"] {
    background-color: %folderview_topbar%;
    min-height: %top_panel_height%;
    max-height: %top_panel_height%;
}

[accessibleName="PathBar"] {
    background-color: %panel_button%;
    border-radius: 3px;
    margin: 4px 2px;
}

[accessibleName="PathBar"] QLabel {
    color: %text%;
    padding-right: 9px;
}

[accessibleName="PathBarButton"] {
    border: 1px solid transparent;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    margin: 4px 2px;
}

[accessibleName="PathBarButton"]:hover {
    background-color: %panel_button_hover%;
    border-color: %panel_button_hover%;
}

[accessibleName="PathBarButton"]:pressed,
[accessibleName="PathBarButton"][pressed="true"] {
    background-color: %panel_button_pressed%;
    border-color: %panel_button_pressed%;
}

/*----------------------------------------------------------------------------*/
[accessibleName="FolderViewSlider"] {
    margin-top: 1px;
}

[accessibleName="FolderViewSlider"]::groove:horizontal {
    border-top: 1px solid %panel_button_pressed%;
    border-bottom: 1px solid %panel_button_pressed%;
    height: 6px;
    margin: 0 12px;
}

[accessibleName="FolderViewSlider"]::sub-page:horizontal { /* left */
    background: %panel_button_pressed%;
    border: 1px solid %panel_button_pressed%;
    height: 6px;
}

[accessibleName="FolderViewSlider"]::add-page:horizontal { /* right */
    background: %panel_button_pressed%;
    border: 1px solid %panel_button_pressed%;
    height: 6px;
}

[accessibleName="FolderViewSlider"]::handle:horizontal {
    background: %text_lc2%;
    border: 1px solid %text_lc2%;
    width: 12px;
    height: 12px;
    border-radius: 1px;
    margin: -4px -12px;
}

[accessibleName="FolderViewSlider"]::handle:horizontal:hover {
    background: %text%;
    border-color: %text%;
}

/* dropdown menus */
FVOptionsPopup {
    padding: 5px 0px;
    background-color: %widget%;
    border: 1px solid %accent%;
}

FVOptionsPopup QLabel {
    color: %text_secondary_rgba%;
}

/*----------------------------------------------------------------------------*/

ThumbnailStrip QScrollBar:horizontal {
    height: 13px;
    background-color: %folderview%;
}

ThumbnailStrip QScrollBar::handle:horizontal {
    background-color: %scrollbar%;
    min-width: 60px;
}

ThumbnailStrip QScrollBar::handle:horizontal:hover {
    background-color: %scrollbar_hover%;
    border-color: %scrollbar_hover%;
}

ThumbnailStrip QScrollBar:vertical {
    width: 13px;
    background-color: %folderview%;
}

ThumbnailStrip QScrollBar::handle:vertical {
    background-color: %scrollbar%;
    min-height: 60px;
}

ThumbnailStrip QScrollBar::handle:vertical:hover {
    background-color: %scrollbar_hover%;
    border-color: %scrollbar_hover%;
}

ThumbnailStrip QScrollBar::sub-page {
    background: none;
}

ThumbnailStrip QScrollBar::add-page {
    background: none;
}

ThumbnailStrip QScrollBar::add-line {
    width: 0px;
    height: 0px;
}

ThumbnailStrip QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/*----------------------------------------------------------------------------*/
/* Right click menu */
/*----------------------------------------------------------------------------*/

ContextMenu {
    background-color: %widget%;
    border: 1px solid %widget_border%;
    border-radius: %contextmenu_border_radius%;
    min-width: %context_menu_width%;
}
ContextMenu QLabel {
    color: %text_secondary_rgba%;
    margin: 0px 0px;
    padding: 0px 0px;
}
/*----------------------------------------------------------------------------*/
[accessibleName="MenuItem"]:hover {
    background-color: %accent_hover_rgba%;
}

[accessibleName="MenuItem"] QLabel {
    padding: 6 0 7 0;
}

[accessibleName="MenuItem"] QLabel:disabled {
    color: %text_secondary_rgba%;
}

[accessibleName="MenuItemText"] {
    color: %text_hc%;
}

[accessibleName="MenuItemShortcutLabel"] {
    color: %text_secondary_rgba%;
}

[accessibleName="ContextMenuButton"] {
    min-height: %context_menu_button_height%;
}

[accessibleName="ContextMenuButton"]:hover {
    background-color: %accent_hover_rgba%;
}

/*----------------------------------------------------------------------------*/
ControlsOverlay {
    border: 0px solid transparent;
    background-color: %overlay_rgba%;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}
/*----------------------------------------------------------------------------*/

InfoBar, InfoBarProxy {
    background-color: %widget%;
}

InfoBar QLabel {
    color: %text_hc%;
}

/*----------------------------------------------------------------------------*/
ZoomIndicatorOverlay {
    background-color: %overlay_rgba%;
    border-color: %overlay_rgba%;
    border-left: 0px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

ZoomIndicatorOverlay QLabel {
    color: %overlay_text%;
}

/*----------------------------------------------------------------------------*/
/* FolderView scrollbars */
/*----------------------------------------------------------------------------*/

FolderView QScrollBar:vertical {
    width: 13px;
    background-color: transparent;
}

FolderView QScrollBar::handle:vertical {
    background-color: %scrollbar%;
    min-height: 60px;
}

FolderView QScrollBar::handle:vertical:hover {
    background-color: %scrollbar_hover%;
}

FolderView QScrollBar::sub-page {
    background: none;
}

FolderView QScrollBar::add-page {
    background: none;
}

FolderView QScrollBar::add-line {
    width: 0px;
    height: 0px;
}

FolderView QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/*----------------------------------------------------------------------------*/
/* TreeView */
/*----------------------------------------------------------------------------*/

FolderView QTreeView {
    background-color: transparent;
    show-decoration-selected: 1;
}

FolderView QTreeView::item {
    border-radius: 0px; /* left padding on hover is wrong unless we add this.. wtf */
    min-height: 24px;
    padding: 2px;
    color: %text_hc2%;
}

FolderView QTreeView::item:hover {
    background-color: %folderview_hc%;
}

FolderView QTreeView::item:selected:!active,
FolderView QTreeView::item:selected:active {
    background-color: %folderview_hc2%;
    border-color: %folderview_hc2%;
}

QTreeView::branch {
    padding-left: 6px;
}

QTreeView::branch:selected {
    background-color: %folderview_hc2%;
}

QTreeView::branch:hover:!selected {
    background-color: %folderview_hc%;
}

QTreeView::branch:has-siblings:!adjoins-item:!selected {
    background: transparent;
}

QTreeView::branch:has-siblings:hover:!adjoins-item:!selected {
    background-color: %folderview_hc%;
}

QTreeView::branch:!has-children:!hover:adjoins-item:!selected {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
        border-image: none;
        image: url(:/res/icons/%icontheme%/other/collapsed.png)
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
        border-image: none;
        image: url(:/res/icons/%icontheme%/other/expanded.png)
}

/*----------------------------------------------------------------------------*/
/* bookmarks widget */
/*----------------------------------------------------------------------------*/

BookmarksItem {
    /*border-radius: 3px;*/
}

BookmarksItem:hover {
    background-color: %folderview_hc%;
}

BookmarksItem QLabel {
    color: %text_hc2%;
}

BookmarksItem[highlighted="true"] {
    background-color: %folderview_hc2%;
    border-color: %folderview_hc2%;
}

/*----------------------------------------------------------------------------*/
/* places panel (bg) */
/*----------------------------------------------------------------------------*/

[accessibleName="PlacesPanel"] {
    background-color: %folderview%;
    border-right: 1px solid %folderview_hc%;
    margin-right: 6px;
}

[accessibleName="PanelSectionHeader"] {
    color: %text_hc%;
    font: bold;
}

[accessibleName="PanelSectionHeader"]:hover {
    color: %text_hc2%;
}

/*----------------------------------------------------------------------------*/
/* places panel buttons */
/*----------------------------------------------------------------------------*/

[accessibleName="PlacesPanelButton"] {
    border-radius: 3px;
}

[accessibleName="PlacesPanelButton"]:hover {
    background-color: %folderview_button_hover%;
}

[accessibleName="PlacesPanelButton"]:pressed,
[accessibleName="PlacesPanelButton"][pressed="true"] {
    background-color: %folderview_button_pressed%;
}

/*----------------------------------------------------------------------------*/
[accessibleName="FolderViewSplitter"]::handle {
    background-color: %folderview%;
}
/*----------------------------------------------------------------------------*/
[accessibleName="VideoPlayerInitProxy"] QLabel {
    color: #BB0000;
    font: bold;
}
/*----------------------------------------------------------------------------*/
ImageInfoOverlay QLabel {
    color: %text%;
}

EntryInfoItem {
    background-color: %widget%;
    color: %text_hc2%;
}

EntryInfoItem:hover {
    background-color: %accent_hover_rgba%;
}
/*----------------------------------------------------------------------------*/
PrintDialog QRadioButton,
PrintDialog QCheckBox {
    padding: 4px;
}

PrintDialog QRadioButton:hover,
PrintDialog QCheckBox:hover {
    /*  background-color: %sys_window_tinted%;  */
}

/*----------------------------------------------------------------------------*/
/* Dialogs: follow the app theme instead of the native palette */

QDialog {
    background-color: %sys_window%;
    color: %sys_text%;
}

QDialog QLabel,
QDialog QCheckBox,
QDialog QRadioButton,
QDialog QGroupBox {
    background-color: transparent;
    color: %sys_text%;
}

QDialog QLabel:disabled,
QDialog QCheckBox:disabled,
QDialog QRadioButton:disabled {
    color: %sys_text_secondary_rgba%;
}

QDialog QScrollArea {
    background-color: transparent;
    border: none;
}

QDialog QScrollArea > QWidget > QWidget {
    background-color: %sys_window%;
}

QDialog QCheckBox::indicator,
QDialog QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: %sys_window_tinted%;
    border: 1px solid %sys_window_tinted_hc%;
}

QDialog QCheckBox::indicator {
    border-radius: 3px;
}

QDialog QRadioButton::indicator {
    border-radius: 8px;
}

QDialog QCheckBox::indicator:hover,
QDialog QRadioButton::indicator:hover {
    border-color: %accent%;
}

QDialog QCheckBox::indicator:checked,
QDialog QRadioButton::indicator:checked {
    background-color: %accent%;
    border-color: %accent%;
}

QDialog QCheckBox::indicator:checked {
    image: url(%check_icon%);
}

QDialog QCheckBox::indicator:disabled,
QDialog QRadioButton::indicator:disabled {
    background-color: %sys_window_tinted_lc%;
    border-color: %sys_window_tinted_lc%;
}

QDialog QLineEdit,
QDialog QPlainTextEdit,
QDialog QTextEdit,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QComboBox,
QDialog QKeySequenceEdit {
    background-color: %sys_window_tinted%;
    color: %sys_text%;
    border: 1px solid %sys_window_tinted_hc%;
    border-radius: 3px;
    padding: 2px 4px;
    selection-background-color: %accent%;
    selection-color: %sys_text%;
}

QDialog QLineEdit:hover,
QDialog QSpinBox:hover,
QDialog QDoubleSpinBox:hover,
QDialog QComboBox:hover {
    border-color: %sys_window_tinted_hc2%;
}

QDialog QLineEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QTextEdit:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QComboBox:focus {
    border-color: %accent%;
}

QDialog QLineEdit:disabled,
QDialog QSpinBox:disabled,
QDialog QDoubleSpinBox:disabled,
QDialog QComboBox:disabled {
    background-color: %sys_window_tinted_lc%;
    color: %sys_text_secondary_rgba%;
}

QDialog QComboBox::drop-down {
    border: none;
    width: 18px;
}

QDialog QComboBox QAbstractItemView {
    background-color: %sys_window_tinted%;
    color: %sys_text%;
    border: 1px solid %sys_window_tinted_hc%;
    selection-background-color: %accent%;
    selection-color: %sys_text%;
    outline: none;
}

QDialog QPushButton {
    background-color: %sys_window_tinted%;
    color: %sys_text%;
    border: 1px solid %sys_window_tinted_hc%;
    border-radius: 3px;
    padding: 2px 14px;
}

QDialog QPushButton:hover {
    background-color: %sys_window_tinted_hc%;
}

QDialog QPushButton:pressed {
    background-color: %sys_window_tinted_lc%;
}

QDialog QPushButton:default {
    border-color: %accent%;
}

QDialog QPushButton:disabled {
    background-color: %sys_window_tinted_lc%;
    color: %sys_text_secondary_rgba%;
}

QDialog QSlider::groove:horizontal {
    height: 4px;
    background-color: %sys_window_tinted_hc%;
    border-radius: 2px;
}

QDialog QSlider::sub-page:horizontal {
    background-color: %accent%;
    border-radius: 2px;
}

QDialog QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
    background-color: %sys_text%;
}

QDialog QSlider::groove:horizontal:disabled,
QDialog QSlider::sub-page:horizontal:disabled {
    background-color: %sys_window_tinted_lc%;
}

QDialog QTableWidget,
QDialog QTableView,
QDialog QTextBrowser,
QDialog QListView,
QDialog QTreeView {
    background-color: %sys_window_tinted_lc2%;
    alternate-background-color: %sys_window_tinted_lc%;
    color: %sys_text%;
    border: 1px solid %sys_window_tinted_lc%;
    gridline-color: %sys_window_tinted_lc%;
    selection-background-color: %accent%;
    selection-color: %sys_text%;
}

QDialog QHeaderView::section {
    background-color: %sys_window_tinted%;
    color: %sys_text%;
    border: none;
    border-right: 1px solid %sys_window_tinted_lc%;
    padding: 3px 6px;
}

QDialog QTableCornerButton::section {
    background-color: %sys_window_tinted%;
    border: none;
}

QDialog QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
}

QDialog QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
}

QDialog QScrollBar::handle:vertical,
QDialog QScrollBar::handle:horizontal {
    background-color: %scrollbar%;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
    margin: 2px;
}

QDialog QScrollBar::handle:vertical:hover,
QDialog QScrollBar::handle:horizontal:hover {
    background-color: %scrollbar_hover%;
}

QDialog QScrollBar::add-line,
QDialog QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: none;
    border: none;
}

QDialog QScrollBar::add-page,
QDialog QScrollBar::sub-page {
    background: none;
}

QDialog QToolTip,
QToolTip {
    background-color: %sys_window_tinted_hc%;
    color: %sys_text%;
    border: 1px solid %sys_window_tinted_hc2%;
}

QMessageBox {
    background-color: %sys_window%;
}

/*----------------------------------------------------------------------------*/
/* Top bar */

[accessibleName="TopBar"] {
    background-color: %folderview_topbar%;
    border-bottom: 1px solid %topbar_border_rgba%;
}

[accessibleName="TopBarLabel"] {
    color: %text_hc%;
    background-color: transparent;
}

[accessibleName="TopBarMenuButton"] {
    color: %text_hc%;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 8px;
}

[accessibleName="TopBarMenuButton"]:hover {
    background-color: %panel_button_hover%;
    border: 1px solid %panel_button_hover%;
}

[accessibleName="TopBarMenuButton"]:pressed,
[accessibleName="TopBarMenuButton"]:open {
    background-color: %panel_button%;
    border: 1px solid %panel_button%;
}

[accessibleName="TopBarMenuButton"]::menu-indicator {
    image: none;
    width: 0px;
}

[accessibleName="TopBarSeparator"] {
    background-color: %topbar_border_rgba%;
}

QMenu[accessibleName="TopBarMenu"] {
    background-color: %widget%;
    color: %text_hc%;
    border: 1px solid %widget_border%;
}

QMenu[accessibleName="TopBarMenu"]::item {
    padding: 5px 18px;
}

QMenu[accessibleName="TopBarMenu"]::item:selected {
    background-color: %accent%;
}

[accessibleName="TopBarButton"] {
    border-radius: 3px;
    border: 1px solid transparent;
    margin-top: 2px;
    margin-bottom: 2px;
}

[accessibleName="TopBarButton"]:hover {
    background-color: %panel_button_hover%;
    border: 1px solid %panel_button_hover%;
}

[accessibleName="TopBarButton"]:pressed,
[accessibleName="TopBarButton"][pressed="true"] {
    background-color: %panel_button%;
    border: 1px solid %panel_button%;
}

/*----------------------------------------------------------------------------*/
/* Collage editor */

CollageWidget {
    background-color: %folderview%;
}

[accessibleName="CollageToolbar"] {
    background-color: %widget%;
    border-bottom: 1px solid %widget_border%;
}

/* the floating panel paints its own blurred, tinted card (CollagePanelFrame), so everything inside stays transparent */
[accessibleName="CollagePanelContainer"],
[accessibleName="CollagePanel"],
[accessibleName="CollagePanelScroll"] {
    background-color: transparent;
    border: none;
}

[accessibleName="CollagePanelSeparator"] {
    background-color: %widget_border%;
    border: none;
}

[accessibleName="CollageSectionTitle"] {
    color: %text_lc%;
    font-weight: bold;
    padding-top: 8px;
}

[accessibleName="CollagePanelContainer"] QPushButton,
[accessibleName="CollagePanel"] QPushButton {
    padding: 6px 12px;
    min-height: 18px;
}

[accessibleName="CollagePanel"] QSpinBox,
[accessibleName="CollagePanel"] QComboBox {
    min-height: 22px;
    padding: 3px 8px;
}

[accessibleName="CollagePanel"] QPushButton[danger="true"] {
    color: #e06464;
}

[accessibleName="CollagePanel"] QPushButton[danger="true"]:hover {
    border-color: #e06464;
}

[accessibleName="CollagePanel"] QPushButton[danger="true"]:disabled {
    color: %text_lc2%;
    border-color: %widget_border%;
}

[accessibleName="CollageStatus"] {
    background-color: %widget%;
    color: %text_lc%;
    border-top: 1px solid %widget_border%;
    padding: 3px 10px;
}

[accessibleName="CollageStatus"][warning="true"] {
    color: #e0a030;
}

[accessibleName="CollageHint"] {
    color: %text_lc%;
}

CollageWidget QLabel,
CollageWidget QCheckBox {
    background-color: transparent;
    color: %text%;
}

CollageWidget QLabel:disabled,
CollageWidget QCheckBox:disabled {
    color: %text_lc2%;
}

CollageWidget QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: %button%;
    border: 1px solid %widget_border%;
    border-radius: 3px;
}

CollageWidget QCheckBox::indicator:hover {
    border-color: %accent%;
}

CollageWidget QCheckBox::indicator:checked {
    background-color: %accent%;
    border-color: %accent%;
    image: url(%check_icon%);
}

CollageWidget QCheckBox {
    spacing: 8px;
}

CollageWidget QPushButton {
    background-color: %button%;
    color: %text_hc%;
    border: 1px solid %widget_border%;
    border-radius: 3px;
    padding: 3px 10px;
}

CollageWidget QPushButton:hover {
    background-color: %button_hover%;
}

CollageWidget QPushButton:pressed {
    background-color: %button_pressed%;
}

CollageWidget QPushButton:checked {
    background-color: %accent%;
    border-color: %accent%;
}

CollageWidget QPushButton:disabled {
    color: %text_lc2%;
}

CollageWidget QSpinBox,
CollageWidget QComboBox {
    background-color: %button%;
    color: %text_hc%;
    border: 1px solid %widget_border%;
    border-radius: 3px;
    padding: 2px 4px;
    selection-background-color: %accent%;
}

CollageWidget QSpinBox:hover,
CollageWidget QComboBox:hover {
    border-color: %text_lc%;
}

CollageWidget QSpinBox:focus,
CollageWidget QComboBox:focus {
    border-color: %accent%;
}

CollageWidget QSpinBox:disabled,
CollageWidget QComboBox:disabled {
    color: %text_lc2%;
}

CollageWidget QComboBox::drop-down {
    border: none;
    width: 18px;
}

CollageWidget QComboBox QAbstractItemView {
    background-color: %button%;
    color: %text_hc%;
    border: 1px solid %widget_border%;
    selection-background-color: %accent%;
    outline: none;
}

CollageWidget QSlider::groove:horizontal {
    height: 4px;
    background-color: %widget_border%;
    border-radius: 2px;
}

CollageWidget QSlider::sub-page:horizontal {
    background-color: %accent%;
    border-radius: 2px;
}

CollageWidget QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
    background-color: %text_hc%;
}

CollageWidget QSlider::groove:horizontal:disabled,
CollageWidget QSlider::sub-page:horizontal:disabled {
    background-color: %widget_border%;
}

[accessibleName="CollagePanelScroll"] QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
}

[accessibleName="CollagePanelScroll"] QScrollBar::handle:vertical {
    background-color: %scrollbar%;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

[accessibleName="CollagePanelScroll"] QScrollBar::handle:vertical:hover {
    background-color: %scrollbar_hover%;
}

[accessibleName="CollagePanelScroll"] QScrollBar::add-line,
[accessibleName="CollagePanelScroll"] QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: none;
    border: none;
}

[accessibleName="CollagePanelScroll"] QScrollBar::add-page,
[accessibleName="CollagePanelScroll"] QScrollBar::sub-page {
    background: none;
}

/* Collage view: floating bar + empty hint */

[accessibleName="CollageOverlayBar"] {
    background-color: %overlay_rgba%;
    border: 1px solid %widget_border%;
    border-radius: 6px;
}

[accessibleName="CollageOverlayBar"] QLabel {
    color: %overlay_text%;
}

CollageWidget [accessibleName="CollageEmptyHint"] {
    background-color: transparent;
    font-size: %font_large%;
}
